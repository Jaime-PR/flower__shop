<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#F2DCE4"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Imagen del ramo -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCarritoProducto"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedImage12dp"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Nombre y Precio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCarritoNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#5E4F55"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Ramo Imperial Rosas" />

            <TextView
                android:id="@+id/tvCarritoPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#7D6C73"
                android:textSize="12sp"
                tools:text="$450" />
        </LinearLayout>

        <!-- Botón quitar (X) -->
        <ImageView
            android:id="@+id/btnEliminarItem"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Quitar producto"
            android:focusable="true"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#7D6C73" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>