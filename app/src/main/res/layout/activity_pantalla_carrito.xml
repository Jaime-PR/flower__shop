<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- CABECERA ROSA -->
    <RelativeLayout
        android:id="@+id/headerCarrito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E30B7B"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTituloCarrito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Mi Carrito"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVaciarCarrito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:text="Carrito"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </RelativeLayout>

    <!-- CONTENIDO DESPLAZABLE -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintTop_toBottomOf="@id/headerCarrito">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- RECYCLERVIEW DE PRODUCTOS EN EL CARRITO -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarrito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"/>
                <!--tools:listitem="@layout/item_carrito_producto"-->

            <!-- TARJETA DE RESUMEN (SUBTOTAL, ENVÍO, TOTAL) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResumenCarrito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#F2DCE4"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Subtotal -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Subtotal:"
                            android:textColor="#7D6C73"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="$0.00"
                            android:textColor="#7D6C73"
                            android:textSize="13sp"/>
                    </RelativeLayout>

                    <!-- Envío -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Envío:"
                            android:textColor="#7D6C73"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvEnvio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="---"
                            android:textColor="#7D6C73"
                            android:textSize="13sp"/>
                    </RelativeLayout>

                    <!-- Línea divisoria -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#F5E6EC" />

                    <!-- Total -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Total:"
                            android:textColor="#5E4F55"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="$0.00"
                            android:textColor="#5E4F55"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÓN FINALIZAR COMPRA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinalizarCompra"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#E30B7B"
                android:text="FINALIZAR COMPRA"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- MENÚ DE NAVEGACIÓN INFERIOR (CARRITO ACTIVO) -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#FFF8FA"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F2DCE4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <!-- Item 1: Inicio -->
            <LinearLayout
                android:id="@+id/navInicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavInicio"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Inicio"
                    android:scaleType="fitCenter"
                    android:src="@drawable/inicio" />

                <TextView
                    android:id="@+id/tvNavInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Inicio"
                    android:textColor="#8E7C83"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Item 2: Explorar -->
            <LinearLayout
                android:id="@+id/navExplorar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavExplorar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Explorar"
                    android:scaleType="fitCenter"
                    android:src="@drawable/explorar" />

                <TextView
                    android:id="@+id/tvNavExplorar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Explorar"
                    android:textColor="#8E7C83"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Item 3: Carrito (Activo) -->
            <LinearLayout
                android:id="@+id/navCarrito"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_active"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavCarrito"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Carrito"
                    android:scaleType="fitCenter"
                    android:src="@drawable/carrito_on" />

                <TextView
                    android:id="@+id/tvNavCarrito"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Carrito"
                    android:textColor="#E30B7B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Item 4: Perfil -->
            <LinearLayout
                android:id="@+id/navPerfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavPerfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Perfil"
                    android:scaleType="fitCenter"
                    android:src="@drawable/perfil" />

                <TextView
                    android:id="@+id/tvNavPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Perfil"
                    android:textColor="#8E7C83"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>