<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#F2DCE4"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Imagen del ramo -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProducto"
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedImage12dp"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Nombre del ramo -->
        <TextView
            android:id="@+id/tvNombreProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#6B5A61"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Ramo Imperial" />

        <!-- Fila inferior: Precio y Botón Carrito -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvPrecioProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:textColor="#7D6C73"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="$450" />

            <!-- Botón rosa con icono de carrito -->
            <FrameLayout
                android:id="@+id/btnAgregarCarrito"
                android:layout_width="38dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_btn_carrito"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivIconoCarritoBtn"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Agregar al carrito"
                    android:scaleType="fitCenter"
                    tools:src="@android:drawable/ic_input_add" />
            </FrameLayout>

        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>